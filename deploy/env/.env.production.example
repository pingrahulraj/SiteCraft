APP_ENV=production
APP_NAME=SiteCraft
API_PORT=8080
DELIVERY_PORT=8083
DELIVERY_BASE_URL=https://www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
STORAGE_ROOT=/var/lib/sitecraft/storage
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://sitecraft:replace-me@127.0.0.1:5432/sitecraft_production?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sitecraft_production
DB_USER=sitecraft
DB_PASSWORD=replace-me
DB_ADMIN_DB=postgres
DB_SSLMODE=require
