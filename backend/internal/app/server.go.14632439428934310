func (s *Server) handlePublishSite(w http.ResponseWriter, r *http.Request) {
	siteID := chi.URLParam(r, "id")
	tenantID, slug, err := s.siteMeta(r.Context(), siteID)
	if err != nil {
		writeAPIError(w, 404, "not_found", "Site not found")
		return
	}
	if _, err := os.Stat(siteWorkspaceFile(s.cfg.StorageRoot, tenantID, siteID, "index.html")); err != nil {
		writeAPIError(w, 400, "validation_error", "index.html is required")
		return
	}
	start := time.Now()
	actor, _ := currentActor(r.Context())
	if !s.rateLimit("publish:"+actor.UserID+":"+siteID, 6, time.Minute, w) {
		return
	}
	s.logEvent("publish_started", map[string]any{"tenant_id": tenantID, "site_id": siteID})
	var publishResponse map[string]any
	var publishStatus int
	err = withSitePublishLock(r.Context(), s.db, siteID, func(conn *sql.Conn) error {
		if err := ensureSiteReleases(s.cfg.StorageRoot, tenantID, siteID); err != nil {
			return err
		}
		_ = activeReleaseRetentionNote(s.cfg.StorageRoot, tenantID, siteID)
		var nextRelease int
		if err := conn.QueryRowContext(r.Context(), `select coalesce(max(release_number),0)+1 from site_releases where site_id=$1`, siteID).Scan(&nextRelease); err != nil {
			return err
		}
		releaseID := uuid.NewString()
		publicURL := publicSiteURL(s.cfg.deliveryURL(), siteID, slug)
		srcRoot := siteWorkspaceDir(s.cfg.StorageRoot, tenantID, siteID)
		dstRoot := siteReleaseDir(s.cfg.StorageRoot, tenantID, siteID, releaseID)
		renderCtx, err := s.buildRenderContext(r.Context(), tenantID, siteID, slug)
		if err != nil {
			return err
		}
		renderErrors, err := renderWorkspaceDir(srcRoot, dstRoot, renderCtx)
		if err != nil {
			return err
		}
		if len(renderErrors) > 0 {
			_ = os.RemoveAll(dstRoot)
			s.auditLog(r.Context(), actor.UserID, tenantID, siteID, "publish", "site", siteID, "failed", map[string]any{"errors": releaseErrorsPayload(renderErrors)})
			s.logEvent("publish_failed", map[string]any{"tenant_id": tenantID, "site_id": siteID, "duration_ms": time.Since(start).Milliseconds(), "error": "template_validation_failed"})
			publishStatus = http.StatusBadRequest
			publishResponse = map[string]any{
				"success": false,
				"errors":  releaseErrorsPayload(renderErrors),
			}
			return nil
		}
		tx, err := conn.BeginTx(r.Context(), nil)
		if err != nil {
			return err
		}
		defer tx.Rollback()
		artifactPath := filepath.ToSlash(filepath.Join("sites", tenantID, siteID, "releases", releaseID))
		if _, err := tx.ExecContext(r.Context(), `insert into site_releases(id,tenant_id,site_id,release_number,artifact_path,public_url,status,created_at) values($1,$2,$3,$4,$5,$6,'published',now())`,
			releaseID, tenantID, siteID, nextRelease, artifactPath, publicURL); err != nil {
			return err
		}
		if _, err := tx.ExecContext(r.Context(), `update sites set active_release_id=$1,status='published',published_at=now(),updated_at=now() where id=$2`, releaseID, siteID); err != nil {
			return err
		}
		if _, err := tx.ExecContext(r.Context(), `insert into audit_logs(id,tenant_id,site_id,action,target_type,target_id,outcome,created_at) values($1,$2,$3,'publish','site',$4,'success',now())`, uuid.NewString(), tenantID, siteID, siteID); err != nil {
			return err
		}
		if err := tx.Commit(); err != nil {
			return err
		}
		s.logEvent("active_release_switched", map[string]any{"tenant_id": tenantID, "site_id": siteID, "release_id": releaseID})
		s.auditLog(r.Context(), actor.UserID, tenantID, siteID, "publish", "site", siteID, "success", map[string]any{"release_id": releaseID, "public_url": publicURL})
		publishStatus = http.StatusOK
		publishResponse = map[string]any{"success": true, "site_id": siteID, "release_id": releaseID, "public_url": publicURL, "published_at": time.Now().UTC().Format(time.RFC3339), "message": "Website published successfully"}
		s.logEvent("publish_completed", map[string]any{"tenant_id": tenantID, "site_id": siteID, "release_id": releaseID, "duration_ms": time.Since(start).Milliseconds()})
		return nil
	})
	if err != nil {
		if strings.Contains(strings.ToLower(err.Error()), "publish already in progress") {
			writeAPIError(w, http.StatusConflict, "publish_in_progress", "Publish already in progress")
			return
		}
		s.auditLog(r.Context(), actor.UserID, tenantID, siteID, "publish", "site", siteID, "failed", map[string]any{"error": err.Error()})
		s.logEvent("publish_failed", map[string]any{"tenant_id": tenantID, "site_id": siteID, "duration_ms": time.Since(start).Milliseconds(), "error": err.Error()})
		writeAPIError(w, 500, "publish_failed", "Workspace could not be published")
		return
	}
	if publishResponse != nil {
		writeJSON(w, publishStatus, publishResponse)
	}
}

func (s *Server) handlePreviewSite(w http.ResponseWriter, r *http.Request) {
	siteID := chi.URLParam(r, "id")
	tenantID, slug, err := s.siteMeta(r.Context(), siteID)
	if err != nil {
		writeAPIError(w, 404, "not_found", "Site not found")
		return
	}
	relativePath := strings.TrimSpace(r.URL.Query().Get("path"))
	if relativePath == "" {
		relativePath = "index.html"
	}
	relativePath = filepath.ToSlash(filepath.Clean(strings.ReplaceAll(relativePath, "\\", "/")))
	relativePath = strings.TrimPrefix(relativePath, "/")
	if relativePath == "." || relativePath == "" {
		relativePath = "index.html"
	}
	if strings.Contains(relativePath, "..") || !strings.EqualFold(filepath.Ext(relativePath), ".html") {
		writeAPIError(w, 400, "invalid_path", "Preview path must reference an HTML workspace file")
		return
	}
	srcRoot := siteWorkspaceDir(s.cfg.StorageRoot, tenantID, siteID)
	renderCtx, err := s.buildRenderContext(r.Context(), tenantID, siteID, slug)
	if err != nil {
		writeAPIError(w, 500, "preview_failed", "Preview context could not be built")
		return
	}
	rendered, renderErrors, err := renderWorkspaceHTMLFile(srcRoot, relativePath, renderCtx)
	if err != nil {
		if errors.Is(err, os.ErrNotExist) {
			writeAPIError(w, 404, "not_found", "Preview file not found")
			return
		}
		writeAPIError(w, 500, "preview_failed", "Preview could not be generated")
		return
	}
	if len(renderErrors) > 0 {
		w.Header().Set("Content-Type", "text/html; charset=utf-8")
		w.WriteHeader(http.StatusBadRequest)
		_, _ = w.Write([]byte(previewErrorHTML(renderErrors)))
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Header().Set("Cache-Control", "no-store")
	_, _ = w.Write([]byte(rendered))
}

func (s *Server) handleServePublishedSite(w http.ResponseWriter, r *http.Request) {
	var tenantID, siteID string
	var activeReleaseID sql.NullString
	requestedSiteID := chi.URLParam(r, "siteID")
	slug := chi.URLParam(r, "slug")
	requestPath := strings.TrimPrefix(chi.URLParam(r, "*"), "/")
	siteLookupByIDOnly := requestedSiteID != "" && requestPath == "" && (slug == "" || strings.Contains(slug, "."))
	var err error
	if siteLookupByIDOnly {
		err = s.db.QueryRowContext(r.Context(), `select tenant_id,id,active_release_id from sites where id=$1 and status='published'`, requestedSiteID).Scan(&tenantID, &siteID, &activeReleaseID)
		if err != nil && slug == "" {
			err = s.db.QueryRowContext(r.Context(), `select tenant_id,id,active_release_id from sites where slug=$1 and status='published'`, requestedSiteID).Scan(&tenantID, &siteID, &activeReleaseID)
		}
		if slug != "" {
			requestPath = slug
		}
	} else if requestedSiteID != "" {
		err = s.db.QueryRowContext(r.Context(), `select tenant_id,id,active_release_id from sites where id=$1 and slug=$2 and status='published'`, requestedSiteID, slug).Scan(&tenantID, &siteID, &activeReleaseID)
	} else {
		err = s.db.QueryRowContext(r.Context(), `select tenant_id,id,active_release_id from sites where slug=$1 and status='published'`, slug).Scan(&tenantID, &siteID, &activeReleaseID)
	}
	if err != nil {
		s.logEvent("delivery_file_missing", map[string]any{"site_id": requestedSiteID, "slug": slug, "path": requestPath, "reason": "site_lookup_failed"})
		http.NotFound(w, r)
		return
	}
	if requestPath == "" {
		requestPath = "index.html"
	}
	requestPath = filepath.Clean(strings.ReplaceAll(requestPath, "\\", "/"))
	requestPath = strings.ReplaceAll(requestPath, "\\", "/")
	requestPath = strings.TrimPrefix(requestPath, "/")
	if requestPath == "." {
		requestPath = "index.html"
	}
	if requestPath == ".." || strings.HasPrefix(requestPath, "../") || strings.Contains(requestPath, "/../") {
		s.logEvent("delivery_file_missing", map[string]any{"tenant_id": tenantID, "site_id": siteID, "path": requestPath, "reason": "invalid_path"})
		http.NotFound(w, r)
		return
	}
	if !activeReleaseID.Valid || strings.TrimSpace(activeReleaseID.String) == "" {
		s.logEvent("delivery_file_missing", map[string]any{"tenant_id": tenantID, "site_id": siteID, "path": requestPath, "reason": "active_release_missing"})
		http.NotFound(w, r)
		return
	}
	target := siteReleaseFile(s.cfg.StorageRoot, tenantID, siteID, activeReleaseID.String, requestPath)
	content, err := os.ReadFile(target)
	if err != nil {
		s.logEvent("delivery_file_missing", map[string]any{"tenant_id": tenantID, "site_id": siteID, "release_id": activeReleaseID.String, "path": requestPath, "resolved_path": target, "reason": "file_not_found"})
		http.NotFound(w, r)
		return
	}
	w.Header().Set("Content-Type", contentTypeForPath(requestPath))
	if strings.EqualFold(filepath.Ext(requestPath), ".html") {
		w.Header().Set("Cache-Control", "no-cache")
	} else {
		w.Header().Set("Cache-Control", "public, max-age=31536000, immutable")
	}
	s.logEvent("delivery_file_served", map[string]any{"tenant_id": tenantID, "site_id": siteID, "release_id": activeReleaseID.String, "path": requestPath, "resolved_path": target, "bytes": len(content)})
	_, _ = w.Write(content)
}

func publicSiteURL(baseURL, siteID, slug string) string {
	return strings.TrimRight(baseURL, "/") + "/sites/" + siteID + "/" + slug
}

func contentTypeForPath(path string) string {
	switch strings.ToLower(filepath.Ext(path)) {
	case ".html":
		return "text/html; charset=utf-8"
	case ".css":
		return "text/css; charset=utf-8"
	case ".js":
		return "application/javascript; charset=utf-8"
	case ".json":
		return "application/json; charset=utf-8"
	case ".png":
		return "image/png"
	case ".jpg", ".jpeg":
		return "image/jpeg"
	case ".svg":
		return "image/svg+xml"
	default:
		if guessed := mime.TypeByExtension(strings.ToLower(filepath.Ext(path))); guessed != "" {
			return guessed
		}
		return "application/octet-stream"
	}
}

