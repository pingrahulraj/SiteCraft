func NewServer(cfg Config) *Server {
	root := cfg.StorageRoot
	if root == "" {
		root = "./storage"
	}
	if !cfg.IsDevelopment() {
		secret := strings.TrimSpace(cfg.JWTSecret)
		if secret == "" || secret == "change-me" {
			panic("JWT_SECRET must be configured for non-development environments")
		}
		if strings.Contains(cfg.FrontendOrigin, "*") {
			panic("CORS_ALLOWED_ORIGINS must be explicit in non-development environments")
		}
	}
	_ = os.MkdirAll(filepath.Join(root, "logs"), 0o755)
	if err := createDatabaseIfMissing(cfg); err != nil {
		panic(err)
	}
	db, err := openPostgres(cfg)
	if err != nil {
		panic(err)
	}
	if err := migrate(db); err != nil {
		panic(err)
	}
	if cfg.IsDevelopment() {
		if err := seed(db, root, cfg.deliveryURL()); err != nil {
			panic(err)
		}
	}
	return &Server{cfg: cfg, db: db, limiter: newFixedWindowLimiter()}
}

