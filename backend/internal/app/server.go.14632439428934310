func cors(origin string) func(http.Handler) http.Handler {
	return handlers.CORS(
		handlers.AllowedOrigins(strings.Split(origin, ",")),
		handlers.AllowedMethods([]string{"GET", "POST", "PUT", "DELETE", "OPTIONS"}),
		handlers.AllowedHeaders([]string{"Authorization", "Content-Type"}),
	)
}

func (s *Server) loggingMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		start := time.Now()
		rr := middleware.NewWrapResponseWriter(w, r.ProtoMajor)
		next.ServeHTTP(rr, r)
		requestID := middleware.GetReqID(r.Context())
		actorID := ""
		if actor, ok := currentActor(r.Context()); ok {
			actorID = actor.UserID
		}
		tenantID := ""
		siteID := ""
		if access, ok := currentSiteAccess(r.Context()); ok {
			tenantID = access.TenantID
			siteID = access.SiteID
		}
		line := fmt.Sprintf("%s level=info service=api request_id=%s actor_id=%s tenant_id=%s site_id=%s route=%s status=%d duration_ms=%d",
			time.Now().UTC().Format(time.RFC3339), requestID, actorID, tenantID, siteID, r.URL.Path, rr.Status(), time.Since(start).Milliseconds())
		_ = appendLog(filepath.Join(s.cfg.StorageRoot, "logs", "api.log"), line)
	})
}

func appendLog(path, line string) error {
	_ = os.MkdirAll(filepath.Dir(path), 0o755)
	f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
	if err != nil {
		return err
	}
	defer f.Close()
	_, err = f.WriteString(line + "\n")
	return err
}

func (s *Server) logEvent(event string, fields map[string]any) {
	parts := []string{
		time.Now().UTC().Format(time.RFC3339),
		"level=info",
		"service=api",
		"event=" + event,
	}
	for key, value := range fields {
		parts = append(parts, fmt.Sprintf("%s=%v", key, value))
	}
	_ = appendLog(filepath.Join(s.cfg.StorageRoot, "logs", "api.log"), strings.Join(parts, " "))
}

func atomicWriteFile(target string, content []byte, perm os.FileMode) error {
	if err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {
		return err
	}
	temp, err := os.CreateTemp(filepath.Dir(target), ".sitecraft-*")
	if err != nil {
		return err
	}
	tempName := temp.Name()
	defer func() { _ = os.Remove(tempName) }()
	if _, err := temp.Write(content); err != nil {
		_ = temp.Close()
		return err
	}
	if err := temp.Sync(); err != nil {
		_ = temp.Close()
		return err
	}
	if err := temp.Close(); err != nil {
		return err
	}
	if err := os.Chmod(tempName, perm); err != nil {
		return err
	}
	return os.Rename(tempName, target)
}

func copyDir(src, dst string) error {
	if err := os.RemoveAll(dst); err != nil {
		return err
	}
	return filepath.WalkDir(src, func(path string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		rel, _ := filepath.Rel(src, path)
		target := filepath.Join(dst, rel)
		if d.IsDir() {
			return os.MkdirAll(target, 0o755)
		}
		content, err := os.ReadFile(path)
		if err != nil {
			return err
		}
		return atomicWriteFile(target, content, 0o644)
	})
}

func withSitePublishLock(ctx context.Context, db *sql.DB, siteID string, fn func(*sql.Conn) error) error {
	conn, err := db.Conn(ctx)
	if err != nil {
		return err
	}
	defer conn.Close()
	var locked bool
	if err := conn.QueryRowContext(ctx, `select pg_try_advisory_lock(hashtextextended($1, 0))`, "publish:"+siteID).Scan(&locked); err != nil {
		return err
	}
	if !locked {
		return fmt.Errorf("publish already in progress")
	}
	defer func() {
		_, _ = conn.ExecContext(context.Background(), `select pg_advisory_unlock(hashtextextended($1, 0))`, "publish:"+siteID)
	}()
	return fn(conn)
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

func writeAPIError(w http.ResponseWriter, status int, code, message string) {
	writeJSON(w, status, map[string]any{"error": map[string]string{"code": code, "message": message}})
}

