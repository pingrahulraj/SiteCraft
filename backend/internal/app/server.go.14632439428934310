func (s *Server) handleSeed(w http.ResponseWriter, r *http.Request) {
	if !s.cfg.IsDevelopment() {
		writeAPIError(w, 404, "not_found", "Resource not found")
		return
	}
	if r.Method == http.MethodPost {
		if err := seed(s.db, s.cfg.StorageRoot, s.cfg.deliveryURL()); err != nil {
			writeAPIError(w, 500, "seed_failed", "Demo content could not be synchronized")
			return
		}
		writeJSON(w, 200, map[string]any{
			"success": true,
			"item": map[string]any{
				"snapshot": seedSnapshot(s.db),
			},
		})
		return
	}
	writeJSON(w, 200, map[string]any{"item": seedSnapshot(s.db)})
}

func (s *Server) handleListSites(w http.ResponseWriter, r *http.Request) {
	actor, ok := currentActor(r.Context())
	if !ok {
		writeAPIError(w, 401, "unauthorized", "Authentication required")
		return
	}
	tenantSlug := strings.TrimSpace(r.URL.Query().Get("tenantSlug"))
	query := `
		select s.id, s.slug, s.name, s.status, s.published_at, s.created_at
		from sites s
		join tenant_users tu on tu.tenant_id = s.tenant_id
		join tenants t on t.id = s.tenant_id
		where tu.user_id = $1 and tu.status = 'active'
	`
	args := []any{actor.UserID}
	if tenantSlug != "" {
		query += ` and t.slug = $2`
		args = append(args, tenantSlug)
	}
	query += ` order by s.created_at desc`
	rows, err := s.db.QueryContext(r.Context(), query, args...)
	if err != nil {
		writeAPIError(w, 500, "query_failed", "Failed to load sites")
		return
	}
	defer rows.Close()
	items := make([]map[string]any, 0)
	for rows.Next() {
		var id, slug, name, status string
		var publishedAt sql.NullTime
		var createdAt time.Time
		if err := rows.Scan(&id, &slug, &name, &status, &publishedAt, &createdAt); err != nil {
			writeAPIError(w, 500, "scan_failed", "Failed to read sites")
			return
		}
		items = append(items, map[string]any{
			"id":          id,
			"slug":        slug,
			"name":        name,
			"description": "",
			"status":      status,
			"previewUrl":  publicSiteURL(s.cfg.deliveryURL(), id, slug),
			"createdAt":   createdAt.Format(time.RFC3339),
		})
	}
	writeJSON(w, 200, map[string]any{"items": items, "total": len(items), "projects": items})
}

func (s *Server) handleGetSite(w http.ResponseWriter, r *http.Request) {
